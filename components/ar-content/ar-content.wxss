/* components/ar-content/ar-content.wxss */
.ar-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
}

.ar-content.show {
  opacity: 1;
  pointer-events: auto;
}

/* 虚拟选手 */
.virtual-player {
  position: absolute;
  bottom: 300rpx;
  left: 50%;
  transform: translateX(-50%) translateY(100rpx);
  text-align: center;
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.virtual-player.show,
.ar-content.show .virtual-player {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.player-image {
  width: 300rpx;
  height: 400rpx;
  border-radius: 20rpx;
  border: 4rpx solid var(--primary-gold);
  box-shadow: 0 0 60rpx rgba(255, 215, 0, 0.5);
}

.player-info {
  margin-top: 16rpx;
}

.player-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-gold);
}

.player-role {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 战斗特效 */
.battle-effects {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.battle-effects.visible {
  opacity: 1;
}

.effect-particle {
  position: absolute;
  border-radius: 50%;
  animation: floatUp 3s infinite ease-in-out;
}

@keyframes floatUp {
  0% {
    transform: translateY(100vh) scale(0);
    opacity: 0;
  }
  20% {
    opacity: 1;
  }
  80% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) scale(1);
    opacity: 0;
  }
}

/* 知识图谱卡片 */
.kg-card {
  position: absolute;
  top: 100rpx;
  right: 30rpx;
  width: 320rpx;
  background: rgba(10, 10, 26, 0.95);
  border: 2rpx solid var(--primary-gold);
  border-radius: 16rpx;
  padding: 24rpx;
  backdrop-filter: blur(10rpx);
  transform: translateX(100rpx);
  opacity: 0;
  transition: all 0.8s ease;
}

.ar-content.show .kg-card {
  transform: translateX(0);
  opacity: 1;
  transition-delay: 0.3s;
}

.kg-header {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--card-border);
}

.kg-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-gold);
}

.kg-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kg-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kg-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.kg-value {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.kg-value.spirit {
  color: var(--primary-red);
}

/* 操作按钮 */
.action-buttons {
  position: absolute;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  display: flex;
  gap: 16rpx;
  transform: translateY(100rpx);
  opacity: 0;
  transition: all 0.5s ease;
}

.ar-content.show .action-buttons {
  transform: translateY(0);
  opacity: 1;
  transition-delay: 0.5s;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  background: rgba(10, 10, 26, 0.9);
  border: 2rpx solid var(--card-border);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  backdrop-filter: blur(10rpx);
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  border: none;
}

.action-btn:active {
  transform: scale(0.96);
}
