/* ar.wxss - AR扫描页面样式 */

.container {
  height: 100vh;
  width: 100vw;
  position: relative;
  overflow: hidden;
  background: #000;
}

/* 相机视图 */
.camera-view {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

/* AR叠加层 */
.ar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

/* 扫描框 */
.scan-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500rpx;
  height: 500rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.5);
  animation: scanPulse 2s infinite;
}

@keyframes scanPulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.05);
    opacity: 1;
  }
}

.frame-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #ffd700;
}

.frame-corner.top-left {
  top: -2rpx;
  left: -2rpx;
  border-right: none;
  border-bottom: none;
}

.frame-corner.top-right {
  top: -2rpx;
  right: -2rpx;
  border-left: none;
  border-bottom: none;
}

.frame-corner.bottom-left {
  bottom: -2rpx;
  left: -2rpx;
  border-right: none;
  border-top: none;
}

.frame-corner.bottom-right {
  bottom: -2rpx;
  right: -2rpx;
  border-left: none;
  border-top: none;
}

/* 准星 */
.crosshair {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40rpx;
  height: 40rpx;
  transform: translate(-50%, -50%);
}

.crosshair::before,
.crosshair::after {
  content: '';
  position: absolute;
  background: #ffd700;
}

.crosshair::before {
  width: 2rpx;
  height: 100%;
  left: 50%;
  transform: translateX(-50%);
}

.crosshair::after {
  width: 100%;
  height: 2rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 识别目标信息 */
.target-info {
  position: absolute;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 10, 26, 0.9);
  border: 2rpx solid var(--primary-gold);
  border-radius: 16rpx;
  padding: 24rpx 40rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.target-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-gold);
  margin-bottom: 8rpx;
}

.target-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 扫描提示 */
.scan-hint {
  position: absolute;
  bottom: 300rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 10, 26, 0.9);
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  backdrop-filter: blur(10rpx);
}

/* 权限弹窗 */
.permission-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.dialog-content {
  width: 80%;
  max-width: 600rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 2rpx solid var(--card-border);
}

.dialog-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-gold);
  margin-bottom: 20rpx;
}

.dialog-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
}

.btn-dialog {
  flex: 1;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn-cancel {
  background: var(--card-border);
  color: var(--text-secondary);
}

.btn-confirm {
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  color: white;
}

/* 控制面板 */
.control-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(180deg, transparent, rgba(10, 10, 26, 0.95));
  pointer-events: auto;
}

.controls-top {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 40rpx;
  transition: transform 0.3s ease;
}

.control-btn:active {
  transform: scale(0.9);
}

.control-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* AR内容区域 */
.ar-content-area {
  animation: fadeIn 0.5s ease;
}

/* 虚拟选手 */
.virtual-player {
  position: absolute;
  bottom: 300rpx;
  left: 50%;
  transform: translateX(-50%) translateY(100rpx);
  text-align: center;
  width: 280rpx;
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.virtual-player.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.player-image-placeholder {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  border: 3rpx solid var(--primary-gold);
  box-shadow: 0 0 60rpx rgba(255, 215, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-avatar {
  font-size: 120rpx;
}

.player-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-gold);
  margin-top: 12rpx;
}

.player-role {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 战斗特效 */
.battle-effects {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.battle-effects.show {
  opacity: 1;
}

.effect-particle {
  position: absolute;
  border-radius: 50%;
  animation: floatUp 3s infinite;
}

@keyframes floatUp {
  0% {
    transform: translateY(100%) scale(0);
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100%) scale(1);
    opacity: 0;
  }
}

/* 知识图谱卡片 */
.kg-card {
  position: absolute;
  width: 340rpx;
  background: rgba(10, 10, 26, 0.95);
  border: 2rpx solid var(--primary-gold);
  border-radius: 16rpx;
  padding: 24rpx;
  opacity: 0;
  transform: translateX(100rpx);
  transition: all 0.8s ease;
  backdrop-filter: blur(10rpx);
}

.kg-card.show {
  opacity: 1;
  transform: translateX(0);
}

.kg-header {
  margin-bottom: 20rpx;
}

.kg-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-gold);
}

.kg-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kg-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kg-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.kg-value {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.spirit-text {
  color: var(--accent-red);
}

.kg-footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--card-border);
  text-align: right;
  font-size: 24rpx;
  color: var(--primary-gold);
}

/* AR操作按钮 */
.ar-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.ar-action-btn {
  flex: 1;
  padding: 24rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-primary);
  transition: all 0.3s ease;
}

.ar-action-btn.primary {
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  border: none;
}

.ar-action-btn:active {
  transform: scale(0.96);
}

/* 识别结果 */
.recognized-result {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
}

.target-image-placeholder {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--card-border);
}

.target-emoji {
  font-size: 200rpx;
}

.target-overlay {
  background: rgba(10, 10, 26, 0.95);
  padding: 30rpx;
  border-radius: 0 0 16rpx 16rpx;
  border: 2rpx solid var(--card-border);
  border-top: none;
}

.btn-ar-activate {
  width: 100%;
  margin-top: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  color: white;
  border-radius: 40rpx;
  font-weight: bold;
  border: none;
}

/* 历史记录面板 */
.history-panel {
  position: absolute;
  bottom: 200rpx;
  left: 30rpx;
  right: 30rpx;
  max-height: 400rpx;
  background: rgba(10, 10, 26, 0.95);
  border-radius: 16rpx;
  border: 2rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
}

.history-header {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--card-border);
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-gold);
}

.history-list {
  max-height: 300rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--card-border);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.history-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: var(--card-border);
}

.history-info {
  flex: 1;
}

.history-name {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.history-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.history-arrow {
  font-size: 32rpx;
  color: var(--primary-gold);
}

/* 底部操作栏 */
.bottom-bar {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
}

.scan-btn {
  width: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  border: none;
  box-shadow: 0 8rpx 40rpx rgba(230, 48, 40, 0.5);
  transition: all 0.3s ease;
}

.scan-btn.scanning {
  background: linear-gradient(135deg, #ff4444, #ffaa00);
  animation: scanGlow 2s infinite;
}

@keyframes scanGlow {
  0%, 100% {
    box-shadow: 0 8rpx 40rpx rgba(230, 48, 40, 0.5);
  }
  50% {
    box-shadow: 0 8rpx 60rpx rgba(255, 215, 0, 0.7);
  }
}

.scan-btn:active {
  transform: scale(0.98);
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  text-align: center;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--card-border);
  border-top-color: var(--primary-gold);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
