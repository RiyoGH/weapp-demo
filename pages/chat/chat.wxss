/* chat.wxss - AI对话页面样式 */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--dark-bg);
}

/* 顶部状态栏 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 20rpx;
  background: linear-gradient(180deg, rgba(230, 48, 40, 0.2), transparent);
  border-bottom: 1rpx solid var(--card-border);
}

.header-left, .header-right {
  width: 120rpx;
}

.back-icon {
  font-size: 48rpx;
  color: var(--primary-gold);
}

.header-right {
  text-align: right;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.header-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ai-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #66ff66;
  animation: blink 2s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.emotion-badge {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--dark-bg);
  margin-top: 8rpx;
}

/* 聊天区域 */
.chat-messages {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

/* 欢迎消息 */
.welcome-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.welcome-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff4444, #ff8833);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.welcome-content {
  flex: 1;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 24rpx;
}

.welcome-text {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--primary-gold);
  margin-bottom: 8rpx;
}

.welcome-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.capabilities {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--card-border);
  border-bottom: 1rpx solid var(--card-border);
  margin-bottom: 20rpx;
}

.cap-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.cap-icon {
  font-size: 40rpx;
}

.cap-item text:last-child {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.quick-questions {
  margin-top: 10rpx;
}

.quick-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

.quick-tag {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: rgba(255, 215, 0, 0.1);
  border: 1rpx solid var(--primary-gold);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--primary-gold);
  margin: 0 10rpx 10rpx 0;
  transition: all 0.3s ease;
}

.quick-tag:active {
  background: rgba(255, 215, 0, 0.3);
  transform: scale(0.96);
}

/* 消息项 */
.message-item {
  margin-bottom: 30rpx;
  display: flex;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.user-message {
  flex-direction: row-reverse;
}

.message-content {
  display: flex;
  max-width: 80%;
}

.user-message .message-content {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin: 0 16rpx;
}

.ai-avatar {
  background: linear-gradient(135deg, #ff4444, #ff8833);
}

.user-avatar {
  background: var(--card-border);
}

.message-bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  position: relative;
  max-width: 100%;
}

.ai-bubble {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-bottom-left-radius: 4rpx;
}

.user-bubble {
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  border-bottom-right-radius: 4rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  word-break: break-word;
}

.user-bubble .message-text {
  color: white;
}

.emotion-tag {
  font-size: 24rpx;
  padding: 4rpx 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.message-time {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
  text-align: right;
}

/* 建议按钮 */
.suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--card-border);
}

.suggestion-btn {
  padding: 10rpx 20rpx;
  background: rgba(255, 215, 0, 0.15);
  border: 1rpx solid var(--primary-gold);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--primary-gold);
  transition: all 0.3s ease;
}

.suggestion-btn:active {
  background: rgba(255, 215, 0, 0.3);
  transform: scale(0.96);
}

/* 输入中状态 */
.typing-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.typing-bubble {
  display: flex;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  border-bottom-left-radius: 4rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-gold);
  animation: typingBounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
  40% { transform: scale(1.2); opacity: 1; }
}

/* 底部输入区 */
.chat-input-area {
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--dark-bg);
  border-top: 1rpx solid var(--card-border);
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 40rpx;
  padding: 12rpx 20rpx;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: var(--primary-gold);
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.2);
}

.chat-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  padding: 8rpx 0;
}

.input-placeholder {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.send-btn {
  padding: 16rpx 32rpx;
  background: var(--card-border);
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-secondary);
  transition: all 0.3s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  color: white;
  box-shadow: 0 4rpx 20rpx rgba(230, 48, 40, 0.4);
}

.send-btn.active:active {
  transform: scale(0.96);
}

.input-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}
