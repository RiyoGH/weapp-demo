/* profile.wxss - 个人中心页面样式 */

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: var(--dark-bg);
}

/* 用户信息头部 */
.profile-header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  background: linear-gradient(135deg, rgba(230, 48, 40, 0.2), rgba(255, 68, 68, 0.1));
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(255, 215, 0, 0.1), transparent);
}

.user-info {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

/* 头像 */
.avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-gold);
  padding: 0;
  margin: 0;
  background: transparent;
  position: relative;
}

.avatar-wrapper::after {
  border: none;
}

.user-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
}

.user-avatar.has-avatar {
  background: transparent;
}

.open-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 72rpx;
}

.user-avatar.default-avatar {
  background: var(--card-bg);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 用户详情 */
.user-details {
  flex: 1;
  margin-left: 30rpx;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name-input {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  background: transparent;
  border: none;
  padding: 0;
}

.user-name-input.filled {
  color: var(--primary-gold);
}

.nickname-placeholder {
  color: var(--text-secondary);
  font-weight: normal;
}

.edit-icon {
  margin-left: 16rpx;
  font-size: 32rpx;
  opacity: 0.6;
}

/* 情感状态 */
.emotion-status {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  font-size: 24rpx;
}

.emotion-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.emotion-text {
  color: var(--primary-gold);
}

/* 用户统计 */
.stats-section {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  margin: -40rpx 30rpx 30rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 20rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
}

.stat-card {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-card:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 60%;
  background: var(--card-border);
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--primary-gold);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stat-icon {
  position: absolute;
  top: -20rpx;
  right: 20rpx;
  font-size: 36rpx;
  opacity: 0.5;
}

/* 快速操作 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  padding: 0 30rpx;
  margin: 30rpx 0;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 16rpx;
  margin: 0 8rpx;
  position: relative;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.96);
  border-color: var(--primary-gold);
}

.action-item.disabled {
  opacity: 0.5;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--text-primary);
}

.action-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--primary-red);
  color: white;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* 菜单列表 */
.menu-section {
  padding: 0 30rpx;
}

.menu-group {
  margin-bottom: 30rpx;
}

.menu-group-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--primary-gold);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--primary-gold);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-value {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 开关样式 */
switch .wx-switch-input {
  background: var(--primary-gold) !important;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 30rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}
